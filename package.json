{
  "name": "chessvox-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing free ChessVox chess tools: Stockfish best move, opening encyclopedia lookup, daily puzzle, and Elo change calculator.",
  "license": "MIT",
  "author": "Mohamed Chami",
  "type": "module",
  "bin": {
    "chessvox-mcp": "src/cli.js"
  },
  "main": "src/server.js",
  "files": [
    "src/",
    "test/",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "start:http": "node src/http.js",
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test",
    "sync-openings": "node --experimental-strip-types scripts/sync-openings.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedCHAMI/chessvox-mcp.git"
  },
  "homepage": "https://chessvox.com/developers",
  "bugs": {
    "url": "https://github.com/MohamedCHAMI/chessvox-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.0",
    "zod": "^3.25.0"
  },
  "keywords": [
    "ai-agent",
    "chess",
    "chess-api",
    "chessvox",
    "claude",
    "cursor",
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "stockfish",
    "stockfish-api"
  ],
  "mcpName": "io.github.MohamedCHAMI/chessvox"
}
