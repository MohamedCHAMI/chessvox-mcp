{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "io.github.MohamedCHAMI/chessvox",
  "description": "Free chess tools: Stockfish best move, openings, daily puzzle, Elo. Local npx or hosted, no key.",
  "version": "1.0.0",
  "title": "ChessVox",
  "websiteUrl": "https://chessvox.com/developers",
  "repository": {
    "url": "https://github.com/MohamedCHAMI/chessvox-mcp",
    "source": "github"
  },
  "license": "MIT",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "chessvox-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://chessvox.com/api/mcp"
    }
  ]
}
